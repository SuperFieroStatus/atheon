{
  "name": "atheon",
  "version": "1.0.0",
  "private": true,
  "description": "Atheon — a streamlined project management tool (Workspace > Project > Board > Task > Subtask).",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blueBright,magentaBright \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
